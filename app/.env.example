# Banco próprio do app (pode ser o mesmo servidor MySQL da API, outro database)
DATABASE_URL=mysql://root:senha@localhost:3306/meetayio_app

# Endereço público deste app (links de login e convites)
APP_URL=http://localhost:3100

# meet-ayio-api: o app é um cliente da API (prefixo de sala "m-")
MEET_AYIO_API_URL=https://api-production-bbcf3.up.railway.app
MEET_AYIO_API_KEY=

# E-mail (Resend). Sem chave, o link de login aparece no log do servidor.
RESEND_API_KEY=
EMAIL_FROM=Meet Ayio <nao-responda@seu-dominio.com.br>
