# --- Conexao com o stack Jitsi no Railway ---
# Host do TCP proxy do Railway que aponta para a porta 5222 do prosody.
# Aceita "host:porta" direto em XMPP_SERVER; XMPP_PORT e o padrao (5222).
XMPP_SERVER=xxxx.proxy.rlwy.net:12345
# Dominios internos do stack (iguais aos do prosody)
XMPP_DOMAIN=meet.jitsi
XMPP_AUTH_DOMAIN=auth.meet.jitsi
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.jitsi
XMPP_MUC_DOMAIN=muc.meet.jitsi
# Dominio "escondido" onde o gravador entra na sala (na stable-11248 o nome e
# este; XMPP_RECORDER_DOMAIN ainda funciona como alias antigo)
XMPP_HIDDEN_DOMAIN=hidden.meet.jitsi
JIBRI_BREWERY_MUC=jibribrewery
# O certificado do prosody e auto-assinado (TLS do XMPP pelo proxy TCP)
XMPP_TRUST_ALL_CERTS=true
# URL publica do web do Jitsi (o Chrome do Jibri abre a sala por aqui)
PUBLIC_URL=https://meet.ayio.com.br
# Mesmas senhas configuradas no prosody do Railway (que cria esses usuarios
# sozinho quando ENABLE_RECORDING=1)
JIBRI_XMPP_USER=jibri
JIBRI_XMPP_PASSWORD=troque
JIBRI_RECORDER_USER=recorder
JIBRI_RECORDER_PASSWORD=troque
# Grava no maximo 4 h por sessao (0 = sem limite)
JIBRI_USAGE_TIMEOUT=240
TZ=America/Sao_Paulo

# --- Envio para a meet-ayio-api ---
MEET_AYIO_API_URL=https://api.meet.ayio.com.br
MEET_AYIO_RECORDER_SECRET=igual-ao-RECORDER_SECRET-da-api
