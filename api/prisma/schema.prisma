// Banco do Meet Ayio (MySQL no Railway).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Cliente da API (SeuCartório, BotAyio...). Só o hash da API key fica salvo.
model Client {
  id                     String       @id @default(uuid())
  slug                   String       @unique
  name                   String
  roomPrefix             String       @unique @map("room_prefix")
  apiKeyHash             String       @unique @map("api_key_hash") @db.Char(64)
  active                 Boolean      @default(true)
  webhookUrl             String?      @map("webhook_url") @db.VarChar(500)
  // Segredo HMAC dos webhooks (o cliente precisa dele para validar a assinatura).
  webhookSecret          String?      @map("webhook_secret") @db.VarChar(80)
  recordingRetentionDays Int          @default(30) @map("recording_retention_days")
  // Transcrição + ata automáticas das gravações (opt-in, LGPD).
  transcriptionEnabled   Boolean      @default(false) @map("transcription_enabled")
  // Instruções próprias do cliente para a ata (substituem o modelo padrão).
  minutesPrompt          String?      @map("minutes_prompt") @db.Text
  createdAt              DateTime     @default(now()) @map("created_at")
  sessions               Session[]
  tokens                 TokenIssue[]
  recordings             Recording[]
  transcripts            Transcript[]

  @@map("clients")
}

// Sala. Criada por POST /sessions ou automaticamente no primeiro token.
model Session {
  id        String   @id @default(uuid())
  roomName  String   @unique @map("room_name") @db.VarChar(64)
  clientId  String   @map("client_id")
  client    Client   @relation(fields: [clientId], references: [id])
  title     String?  @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([clientId, createdAt])
  @@map("sessions")
}

// Cada token emitido (base do /usage).
model TokenIssue {
  id        BigInt   @id @default(autoincrement())
  clientId  String   @map("client_id")
  client    Client   @relation(fields: [clientId], references: [id])
  roomName  String   @map("room_name") @db.VarChar(64)
  moderator Boolean  @default(false)
  // Nome exibido (vai para a ata como participante). Apagado após TOKEN_NAME_RETENTION_DAYS.
  userName  String?  @map("user_name") @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([clientId, createdAt])
  @@index([roomName, createdAt])
  @@map("token_issues")
}

// Gravação feita pelo Jibri e enviada pelo script de finalização.
model Recording {
  id              String    @id @default(uuid())
  clientId        String    @map("client_id")
  client          Client    @relation(fields: [clientId], references: [id])
  roomName        String    @map("room_name") @db.VarChar(64)
  storageKey      String    @map("storage_key") @db.VarChar(300)
  contentType     String    @default("video/mp4") @map("content_type") @db.VarChar(60)
  sizeBytes       BigInt    @default(0) @map("size_bytes")
  durationSec     Int?      @map("duration_sec")
  status          String    @default("READY") @db.VarChar(20) // READY | DELETED
  webhookStatus   String    @default("NONE") @map("webhook_status") @db.VarChar(20) // NONE | PENDING | DELIVERED | FAILED
  webhookAttempts Int       @default(0) @map("webhook_attempts")
  createdAt       DateTime  @default(now()) @map("created_at")
  expiresAt       DateTime  @map("expires_at")
  deletedAt       DateTime? @map("deleted_at")

  @@index([clientId, createdAt])
  @@index([status, expiresAt])
  @@map("recordings")
}

// Transcrição e ata de uma gravação. Apagada junto com a gravação.
model Transcript {
  id           String    @id @default(uuid())
  recordingId  String    @unique @map("recording_id")
  clientId     String    @map("client_id")
  client       Client    @relation(fields: [clientId], references: [id])
  status       String    @default("PENDING") @db.VarChar(20) // PENDING | PROCESSING | DONE | FAILED
  language     String    @default("pt") @db.VarChar(10)
  text         String?   @db.LongText
  segments     Json?     // [{ start, end, text }] em segundos
  durationSec  Int?      @map("duration_sec")
  minutes      String?   @db.LongText // rascunho da ata
  minutesModel String?   @map("minutes_model") @db.VarChar(80)
  error        String?   @db.VarChar(500)
  attempts     Int       @default(0)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([clientId, createdAt])
  @@map("transcripts")
}
