PORT=3000
# MySQL no Railway. Vazio = store em memória (só para dev)
DATABASE_URL=
# Protege as rotas /admin (cadastro de clientes)
ADMIN_TOKEN=troque-por-um-token-longo
# URL pública desta API (links de download do storage local)
PUBLIC_URL=http://localhost:3000

# --- Jitsi (precisam ser IGUAIS às variáveis JWT do prosody no Railway) ---
JWT_APP_ID=meet-ayio
JWT_APP_SECRET=troque-por-um-segredo-longo
JWT_AUDIENCE=meet-ayio
JITSI_XMPP_DOMAIN=meet.jitsi
# Host público do serviço web do Jitsi (sem https://)
JITSI_DOMAIN=seu-web.up.railway.app
TOKEN_TTL_SECONDS=21600

# --- Gravações ---
# Mesmo valor de MEET_AYIO_RECORDER_SECRET no Jibri
RECORDER_SECRET=troque-por-outro-segredo-longo
# Storage local (Railway Volume montado em /data):
RECORDINGS_DIR=./data/recordings
FILES_SECRET=troque-assina-links-de-download
DOWNLOAD_TTL_SECONDS=900
# ...ou bucket S3-compatível (Railway Bucket): se S3_BUCKET estiver preenchido, usa S3
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=0

# --- Webhooks e retenção ---
# Atrasos das tentativas em ms (padrão: na hora, 30 s, 5 min, 30 min)
WEBHOOK_DELAYS_MS=0,30000,300000,1800000
RETENTION_INTERVAL_MS=3600000

# Só para dev sem banco: slug:chave:prefixo
MEET_AYIO_SEED_CLIENTS=seucartorio:chave-dev:sc-
